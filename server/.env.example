# Backend Environment Variables (Render)
# MongoDB Atlas Connection String:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/day90?retryWrites=true&w=majority

# Secret key used for signing JWT tokens (use a long random string):
JWT_SECRET=your-production-jwt-secret-key-replace-this

# Groq Cloud API Key & Model:
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Deployed Frontend URL on Vercel (NO trailing slash):
CLIENT_ORIGIN=https://your-day90-frontend.vercel.app

# Port (Render assigns this automatically, default 3001 locally):
PORT=3001

# Node Environment:
NODE_ENV=production
